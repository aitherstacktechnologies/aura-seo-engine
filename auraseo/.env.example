# Google PageSpeed Insights API Key
# Get your key at: https://developers.google.com/speed/docs/insights/v5/get-started
VITE_PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Supabase Configuration (optional - for audit history)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Use the "Project URL" and the "anon public" key (starts with eyJ...)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Database Schema (run this in SQL Editor)
# CREATE TABLE audits (
#   id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
#   url TEXT NOT NULL,
#   device TEXT NOT NULL,
#   scores JSONB NOT NULL,
#   core_vitals JSONB NOT NULL,
#   audits_list JSONB NOT NULL,
#   created_at TIMESTAMPTZ DEFAULT NOW()
# );
# 
# Enable Row Level Security (RLS) if needed for user-specific audits